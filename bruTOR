echo ""
echo -e "$COLOR3================================== Scan Complete ===================================$RESET"
echo -e "$COLOR2[+] Results saved to: $LOOT_DIR/$RESET"
echo -e "$COLOR2[+] Check files: hydra-*-$TARGET.txt for successful credentials$RESET"
echo ""
echo -e "$COLOR4[*] To view results: ls -lah $LOOT_DIR/$RESET"
echo ""

# Display any found credentials
echo -e "$COLOR3================================ Found Credentials =================================$RESET"
for file in "$LOOT_DIR"/hydra-*-"$TARGET".txt; do
	if [ -f "$file" ]; then
		if grep -q "login:" "$file" 2>/dev/null; then
			echo -e "$COLOR2[+] Found in $(basename $file):$RESET"
			grep "login:" "$file" | tail -5
		fi
	fi
done
echo ""

exit 0
